SECRET_KEY=replace-with-at-least-32-random-characters
DEVICE_API_TOKEN=replace-with-a-long-random-device-token
SUPER_ADMIN_USERNAME=replace-with-provisioned-super-admin-username
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-super-admin-password
KIOSK_API_TOKEN=replace-with-a-long-random-kiosk-token
SESSION_COOKIE_SECURE=false
DATABASE_URL=sqlite:///aquaguard.db
